rules_version = '2';

// Regras do Firestore do MagitechRPG.
//
// Quem é o usuário: o navegador entra no Firebase Auth com um token customizado
// emitido por /api/firebase/token (FirebaseAuthBridge). request.auth.uid é o id
// do usuário no banco e administradores têm a claim `admin`.
//
// O servidor (rotas /api) usa o Admin SDK, que não passa por estas regras —
// escritas privilegiadas (mestre editando ficha de jogador, campanha, catálogos)
// acontecem lá, com autorização própria.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Usuários: têm e-mail e assinatura — cada um lê só o próprio documento.
    // Perfis públicos dos membros de uma campanha vêm da API.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Fichas: o mestre e os colegas de campanha abrem fichas pelo ID; listar,
    // só as próprias. O dono edita a própria ficha direto (sem trocar dono nem
    // id); o mestre edita fichas de jogadores pela API. Criar/apagar: só API.
    match /charsheets/{charsheetId} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id;
      allow create, delete: if false;
    }

    // Campanhas: leitura pelo ID (o código da campanha é o convite; a API
    // converte código em ID). Sem listagem da coleção. Escrita só pela API.
    match /campaigns/{campaignId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Notificações: só as do próprio usuário. Criar/marcar como lida: pela API.
    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Catálogos lidos direto pelo navegador
    match /spells/{spellId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /powers/{powerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Todo o resto (rpg_systems, campaign_stats, jobs, perks, items, weapons,
    // armors, skills, combatEffects...) não tem regra e, portanto, só é
    // acessível pelo servidor.
  }
}
