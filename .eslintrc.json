{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "env": {
      "browser": true,
      "es2021": true
  },
  "plugins": [
      "react",
      "@typescript-eslint",
      "unused-imports",
      "unused-vars",
      "react-hooks",
      "prettier",
      "unicorn"
  ],
  "extends": [
      "plugin:react/recommended",
      "standard-with-typescript",
      "prettier",
      "plugin:prettier/recommended",
      "next/core-web-vitals"
  ],
  "overrides": [
      {
          "files": [
              "themes/**",
              "scripts/**",
              "**/__tests__/**",
              "**/*.test.ts",
              "components/misc/elementGlyphs.ts",
              "app/grimoire/pdf/**"
          ],
          "rules": {
              "no-restricted-syntax": "off"
          }
      }
  ],
  "settings": {
      "react": {
          "version": "18.2"
      },
      "import/resolver": {
          "node": {
              "paths": [
                  "src"
              ]
          },
          "typescript": {}
      }
  },
  "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
  },
  "rules": {
      "prettier/prettier": [
          "off"
      ],
      "@typescript-eslint/no-misused-promises": [
          "off",
          {}
      ],
      "no-use-before-define": "off",
      "@typescript-eslint/no-floating-promises": [
          "off",
          {}
      ],
      "@typescript-eslint/no-use-before-define": [
          "error",
          {}
      ],
      "react/react-in-jsx-scope": "off",
      "react/jsx-filename-extension": [
          "warn",
          {
              "extensions": [
                  ".tsx",
                  ".ts",
                  ".js"
              ]
          }
      ],
      "no-shadow": "off",
      "@typescript-eslint/no-shadow": [
          "error",
          {}
      ],
      "@typescript-eslint/strict-boolean-expressions": [
          "off",
          {}
      ],
      "@typescript-eslint/explicit-function-return-type": [
          "off",
          {
              "allowExpressions": true
          }
      ],
      "max-len": [
          "warn",
          {
              "code": 200
          }
      ],
      "@typescript-eslint/no-non-null-assertion": "off",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "off",
      "@typescript-eslint/no-unsafe-argument": "off",
      "@typescript-eslint/no-confusing-void-expression": "off",
      "react/function-component-definition": [
          "error",
          {
              "namedComponents": "function-declaration"
          }
      ],
      "import/prefer-default-export": "off",
      "comma-dangle": [
          "error",
          "never"
      ],
      "import/no-extraneous-dependencies": [
          "off"
      ],
      "import/no-duplicates": [
          "off"
      ],
      "@typescript-eslint/consistent-type-assertions": [
          "off"
      ],
      "no-multiple-empty-lines": "error",
      "indent": [
          "error",
          4
      ],
      "@typescript-eslint/restrict-template-expressions": "off",
      "@typescript-eslint/prefer-nullish-coalescing": "off",
      "@typescript-eslint/require-array-sort-compare": [
          "off",
          {
              "ignoreStringArrays": true
          }
      ],
      "unused-imports/no-unused-imports": "warn",
      "unused-vars/no-unused-vars": "warn",
      "object-curly-spacing": [
          2,
          "always"
      ],
      "array-bracket-spacing": [
          2,
          "always"
      ],
      "space-infix-ops": "error",
      "camelcase": "error",
      "arrow-spacing": "error",
      "space-before-blocks": "error",
      "block-spacing": "error",
      "linebreak-style": 0,
      "quotes": [
          "error",
          "single"
      ],
      "no-restricted-syntax": [
          "warn",
          {
              "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/], TemplateElement[value.raw=/#[0-9a-fA-F]{3,8}\\b/]",
              "message": "Cor solta: use um token de themes/tokens.ts ou o tema (primary.main, background.paper, text.secondary...)."
          },
          {
              "selector": "Literal[value=/\\brgba?\\(/], TemplateElement[value.raw=/\\brgba?\\(/]",
              "message": "rgba solto: use um token de themes/tokens.ts ou alpha() de uma cor do tema."
          },
          {
              "selector": "Literal[value=/(linear|radial|conic)-gradient\\(/], TemplateElement[value.raw=/(linear|radial|conic)-gradient\\(/]",
              "message": "Gradiente decorativo é proibido no design system: use uma superfície plana (background.paper ou background.raised)."
          },
          {
              "selector": "Literal[value=/\\binfinite\\b/], TemplateElement[value.raw=/\\binfinite\\b/]",
              "message": "Animação infinita é proibida no design system (brilho, pulso e shine): transições curtas, uma vez só."
          },
          {
              "selector": "Literal[value=/translateY\\(-[0-9.]+(px|rem|em)\\)/], TemplateElement[value.raw=/translateY\\(-[0-9.]+(px|rem|em)\\)/]",
              "message": "Cartão que sobe no hover é proibido: no hover, só a borda muda (border-strong)."
          },
          {
              "selector": "Property[key.name='backdropFilter']",
              "message": "Vidro desfocado só em camadas flutuantes; fora delas use uma superfície sólida."
          },
          {
              "selector": "Property[key.name=/^(boxShadow|textShadow)$/][value.type=/^(Literal|TemplateLiteral)$/][value.value!='none']",
              "message": "Sem brilho nem sombra solta: só a camada flutuante tem sombra (theme.shadows ou shadow.overlay de themes/tokens.ts)."
          },
          {
              "selector": "ImportSpecifier[imported.name=/^AutoAwesome/], ImportDefaultSpecifier[local.name=/^AutoAwesome/]",
              "message": "O ícone de faíscas não é marca de magia: use <ElementIcon element=... /> de components/misc/ElementIcon."
          }
      ]
  }
}